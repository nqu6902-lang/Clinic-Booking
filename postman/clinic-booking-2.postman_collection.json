{
  "info": {
    "name": "clinic-booking 2 Đề tài 6",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Chạy trên DB demo đã seed. Điền demo_password trong environment. Tạo tài khoản/lượt khám riêng mỗi lần. Chạy trước 23:55 giờ Việt Nam, trong dưới 2 phút, để check-in cùng ngày."
  },
  "item": [
    {
      "name": "01 Health",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/health"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const run=Date.now().toString(); pm.environment.set(\"run\",run);",
              "pm.environment.set(\"slot_start\",new Date(Date.now()+120000).toISOString());",
              "pm.environment.set(\"slot_end\",new Date(Date.now()+1320000).toISOString());",
              "pm.environment.set(\"day\",new Intl.DateTimeFormat(\"en-CA\",{timeZone:\"Asia/Ho_Chi_Minh\"}).format(new Date()));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
